      "skos:inScheme": {
        "@id": "m3gim-vocab:agentRoles"
      }
    },
    {
      "@id": "m3gim-vocab:photographer",
      "@type": "skos:Concept",
      "skos:prefLabel": "fotograf",
      "skos:definition": "Person, die eine im Dokument enthaltene oder nachgewiesene Aufnahme hergestellt hat.",
      "skos:inScheme": {
        "@id": "m3gim-vocab:agentRoles"
      }
    },
    {
      "@id": "m3gim-vocab:playbackFee",
