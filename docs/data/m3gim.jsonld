    },
    {
      "@id": "m3gim-vocab:performanceFee",
      "@type": "skos:Concept",
      "skos:prefLabel": "abendgage",
      "skos:definition": "Honorar für einen einzelnen Auftritt.",
      "skos:inScheme": {
        "@id": "m3gim-vocab:financialItemTypes"
      }
    },
    {
      "@id": "m3gim-vocab:performancePlace",
      "@type": "skos:Concept",
      "skos:prefLabel": "auffuehrungsort",
      "skos:definition": "Ort, an dem eine Aufführung stattfand. Der Wert steht auch an Institutionen, die dann als Ortsvertreter dienen.",
