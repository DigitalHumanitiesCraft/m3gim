      "skos:inScheme": {
        "@id": "m3gim-vocab:agentRoles"
      }
    },
    {
      "@id": "m3gim-vocab:protagonist",
      "@type": "skos:Concept",
      "skos:prefLabel": "protagonist",
      "skos:definition": "Erfasste Angabe der Hauptpartie einer Produktion. Der Wert bezeichnet eine Bühnenrolle und steht nur wegen der Erfassung unter den Akteursrollen.",
      "skos:inScheme": {
        "@id": "m3gim-vocab:agentRoles"
      }
    },
    {
