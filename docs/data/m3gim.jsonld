      "skos:definition": "Institution, die eine Veranstaltung ausrichtet.",
      "skos:inScheme": {
        "@id": "m3gim-vocab:agentRoles"
      }
    },
    {
      "@id": "m3gim-vocab:performance",
      "@type": "skos:Concept",
      "skos:prefLabel": "aufführung",
      "skos:definition": "Bezug auf eine Aufführung, als Ereignis, als Werkbezug oder als Datierung.",
