# M³GIM Project .gitignore

# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.ENV/

# PyCharm
.idea/

# VS Code
.vscode/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ==========================================
# Data Files
# ==========================================
# Large data files (use Git LFS or external storage)
*.xlsx
*.xls
*.csv
# The archival capture lives here and must stay versioned; every report and
# every dataset is reproducible from it.
!data/google-spreadsheet/*.xlsx

# PDF scans (too large for Git)
*.pdf

# Compressed archives
*.zip
*.tar.gz
*.rar
*.7z

# Temporary data files
data/raw_sheets_export.json
data/*_temp.json
data/*_backup_*.json

# Roh-Backups der Google-Drive-Exporte (backup-only, lokal, via scripts/backup.py).
# DSGVO: koennen sensible Dateien enthalten (Handreichung, Antrag) - nie committen.
data/backup/

# Pipeline-generated view JSONs (copies live in docs/data/)
data/output/views/
data/output-v2/views/

# ==========================================
# Credentials & Secrets
# ==========================================
.env
.env.local
.env.*.local
secrets.json
credentials.json
service_account.json
*.key
*.pem

# Google OAuth tokens
token.pickle
token.json

# ==========================================
# Claude Code IDE
# ==========================================
.claude/

# ==========================================
