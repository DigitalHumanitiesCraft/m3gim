        m3gim-vocab:performance , m3gim-vocab:performancePlace , m3gim-vocab:recording .

m3gim-vocab:rolesAtDates
    a skos:Collection ;
    skos:prefLabel "Datumsrollen"@de ;
    skos:altLabel "roles at dates"@en ;
    rdfs:comment "Rollen, die im Datensatz an einer Datierung stehen."@de ;
    skos:editorialNote "Die frühere Aufteilung dieser Rollen auf typisierte Datumsproperties und eine Auffangklasse ist entfallen. Jede Datierung hängt jetzt als Annotationsknoten am Dokument und trägt ihre Rolle in m3gim-ontology:role."@de ;
    skos:member m3gim-vocab:broadcastDate , m3gim-vocab:conversationDate , m3gim-vocab:creation ,
        m3gim-vocab:departure , m3gim-vocab:dispatch , m3gim-vocab:dressRehearsal ,
        m3gim-vocab:framingEvent , m3gim-vocab:installmentPeriod , m3gim-vocab:issueDate ,
        m3gim-vocab:mentioned , m3gim-vocab:performance , m3gim-vocab:premiere ,
        m3gim-vocab:publicationDate , m3gim-vocab:receiving , m3gim-vocab:reception ,
        m3gim-vocab:recording , m3gim-vocab:rehearsal , m3gim-vocab:rehearsalStartDate ,
        m3gim-vocab:season , m3gim-vocab:transferDate , m3gim-vocab:wageConfirmationDate .

