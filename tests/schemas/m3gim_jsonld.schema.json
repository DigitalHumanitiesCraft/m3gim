{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhcraft.org/m3gim/schemas/m3gim_jsonld.schema.json",
  "title": "M3GIM JSON-LD Archive",
  "type": "object",
  "required": ["@context", "@graph"],
  "properties": {
    "@context": {
      "type": "object",
      "required": ["rico", "m3gim-ontology", "m3gim-data", "m3gim-vocab", "wd", "owl", "geo", "skos", "xsd"]
    },
    "@graph": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/graphNode" }
    },
    "m3gim-ontology:exportDate": { "type": "string" },
    "m3gim-ontology:recordCount": { "type": "integer", "minimum": 0 },
    "m3gim-ontology:recordSetCount": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "graphNode": {
      "type": "object",
      "required": ["@id", "@type"],
      "properties": {
        "@id": {
          "type": "string",
          "pattern": "^(m3gim-data|m3gim-vocab|wd):[\\w/_.-]+$"
        },
        "@type": {
          "type": "string",
          "enum": ["rico:Record", "rico:RecordSet", "skos:Concept", "m3gim-ontology:Annotation", "m3gim-ontology:Performance", "m3gim-ontology:StageRole"]
        },
        "rico:identifier": { "type": "string" },
        "rico:title": { "type": "string" },
        "rico:date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?(/\\d{4}(-\\d{2}(-\\d{2})?)?)?$"
        },
        "rico:creationDate": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?(/\\d{4}(-\\d{2}(-\\d{2})?)?)?$"
        },
        "rico:hasDocumentaryFormType": { "type": "object" },
        "rico:hasOrHadLanguage": { "type": "string" },
        "rico:hasExtent": { "type": "string" },
        "rico:scopeAndContent": { "type": "string" },
        "m3gim-ontology:processingStatus": {
          "type": "string",
          "enum": ["abgeschlossen", "begonnen", "zurueckgestellt"]
        },
        "m3gim-ontology:accessStatus": { "type": "string" },
        "m3gim-ontology:digitizationStatus": { "type": "string" },
        "m3gim-ontology:atDate": { "type": "string" },
        "m3gim-ontology:atPlace": { "$ref": "#/$defs/entityRef" },
        "role": { "$ref": "#/$defs/roleRef" },
        "m3gim-ontology:derivedFromRole": { "type": "string" },
        "m3gim-ontology:hasAnnotation": {
          "oneOf": [
            { "$ref": "#/$defs/idRef" },
            { "type": "array", "items": { "$ref": "#/$defs/idRef" } }
          ]
        },
        "m3gim-ontology:hasAssociatedAgent": {
          "oneOf": [
            { "$ref": "#/$defs/entityRef" },
            { "type": "array", "items": { "$ref": "#/$defs/entityRef" } }
          ]
        },
        "rico:hasOrHadLocation": {
          "oneOf": [
            { "$ref": "#/$defs/entityRef" },
            { "type": "array", "items": { "$ref": "#/$defs/entityRef" } }
          ]
        },
        "rico:hasOrHadSubject": {
          "oneOf": [
            { "$ref": "#/$defs/entityRef" },
            { "type": "array", "items": { "$ref": "#/$defs/entityRef" } }
          ]
        },
        "rico:hasOrHadPart": {
          "oneOf": [
            { "$ref": "#/$defs/idRef" },
            { "type": "array", "items": { "$ref": "#/$defs/idRef" } }
          ]
        },
        "rico:hasRecordSetType": { "type": "object" }
      }
    },
    "entityRef": {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string",
          "pattern": "^wd:Q\\d+$"
        },
        "@type": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/roleRef" },
        "m3gim-ontology:derivedFromRole": { "type": "string" },
        "composer": { "type": "string" },
        "owl:sameAs": { "type": "string" },
        "schema:birthDate": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?"
        },
        "schema:deathDate": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?"
        },
        "m3gim-ontology:wdPremiereDate": { "type": "string" },
        "geo:lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "geo:long": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "roleRef": {
      "description": "Verweis auf ein Concept des Rollenvokabulars, mit dem mitgefuehrten Anzeigetext. Ein blosser String bleibt zugelassen fuer den einen Wert der Rollenspalte, den das Vokabular begruendet nicht als Begriff fuehrt (Vertragsstatus, data.md § 11).",
      "oneOf": [
        {
          "type": "object",
          "required": ["@id", "skos:prefLabel"],
          "properties": {
            "@id": { "type": "string", "pattern": "^m3gim-vocab:[A-Za-z]\\w*$" },
            "skos:prefLabel": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "string", "minLength": 1 }
      ]
    },
    "idRef": {
      "type": "object",
      "required": ["@id"],
      "properties": {
        "@id": { "type": "string", "pattern": "^m3gim-data:[\\w/_.-]+$" }
      }
    }
  }
}
